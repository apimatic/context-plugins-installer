{
  // Typechecks src and test together with no output. The build (tsconfig.build.json)
  // narrows this to src and emits lib/.
  "compilerOptions": {
    // Node 18 is the engine floor; @types/node is pinned to 18 for the same reason.
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    // The package is CommonJS (bin/cli.js and the brand wrapper `require` it),
    // so node16 resolution against a package.json with no "type" emits CJS.
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}

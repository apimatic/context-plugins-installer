{
  "name": "context-plugins",
  "version": "0.7.0",
  "description": "Install a plugin from a plugin marketplace into Claude Code, Cursor, and VS Code with one command.",
  "keywords": [
    "claude-code",
    "cursor",
    "vscode",
    "copilot",
    "plugin",
    "plugins",
    "skills",
    "marketplace",
    "installer",
    "cli"
  ],
  "license": "MIT",
  "author": "APIMatic <developer@apimatic.io>",
  "homepage": "https://github.com/apimatic/context-plugins-installer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apimatic/context-plugins-installer.git"
  },
  "bugs": {
    "url": "https://github.com/apimatic/context-plugins-installer/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "context-plugins": "bin/cli.js"
  },
  "files": [
    "bin/",
    "lib/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test.js",
    "syntax": "node --check bin/cli.js && node --check bin/require-node.js",
    "prepare": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^1.0.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

  ],
  "license": "MIT",
  "author": "APIMatic <developer@apimatic.io>",
  "homepage": "https://github.com/apimatic/context-plugins-installer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apimatic/context-plugins-installer.git"
  },
  "bugs": {
    "url": "https://github.com/apimatic/context-plugins-installer/issues"
  },
  "engines": {
    "node": ">=18.0.0"
